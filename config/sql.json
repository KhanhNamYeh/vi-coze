{
  "kb": "sql",
  "name": "Tài liệu mô tả schema CSDL",
  "description": "Mỗi mục là một bảng: ý nghĩa, danh sách cột, mối liên kết, ghi chú nghiệp vụ. Cắt theo cấu trúc vì ranh giới bảng đã rõ sẵn.",
  "parse": {
    "suffixes": [
      ".docx",
      ".pdf"
    ],
    "table_heading": "^\\*\\s+\\d+\\.\\s+\\*\\*(?P<name>.+?)\\*\\*\\s*$",
    "replacements": [
      {
        "pattern": "(?<=\\|\\s\\*\\*)Cột\\d+(?=\\*\\*\\s\\|)",
        "replace": "Tên cột"
      },
      {
        "pattern": "(?<=\\|\\s)Cột\\d+(?=\\s*\\|)",
        "replace": "Tên cột"
      }
    ]
  },
  "extract": {
    "enabled": true,
    "extractor": "block_extract",
    "heading_roles": {
      "1": "section",
      "2": "table"
    },
    "strip_cell_emphasis": true,
    "roles": [
      {
        "role": "table_meaning",
        "match": [
          "^Ý nghĩa của bảng\\s*:",
          "^Ý nghĩa\\s*:"
        ]
      },
      {
        "role": "column_intro",
        "match": [
          "^Chi tiết các cột( trong bảng)?\\s*:"
        ]
      },
      {
        "role": "relation_hint",
        "match": [
          "^Mối liên kết\\s*:",
          "^Liên kết\\s*:"
        ]
      },
      {
        "role": "business_rule",
        "match": [
          "^Ghi chú\\s*:",
          "^Lưu ý\\s*:"
        ]
      }
    ]
  },
  "link": {
    "enabled": true
  },
  "chunk": {
    "split_on": [
      {
        "by": "heading",
        "level": 2
      }
    ],
    "budget": {
      "unit": "token",
      "max": 2048,
      "min": 120,
      "overlap": 0,
      "on_overflow": "keep",
      "on_underflow": "keep"
    },
    "filter": {
      "atomic_modalities": [],
      "drop_empty": true
    },
    "context": {
      "breadcrumb": {
        "enabled": true,
        "separator": " > ",
        "include_doc_title": true
      },
      "inherit": {
        "from_roles": [
          "table_meaning"
        ],
        "max_chars": 300
      },
      "restore_labels": true
    }
  },
  "embed": {
    "dense": {
      "model": "AITeamVN/Vietnamese_Embedding",
      "dim": 1024,
      "batch": 16,
      "max_tokens": 2048,
      "normalize": true,
      "query_prefix": "",
      "passage_prefix": ""
    },
    "sparse": {
      "model": "Qdrant/bm25",
      "disable_stemmer": true,
      "k": 1.2,
      "b": 0.0
    }
  },
  "index": {
    "store": "qdrant",
    "collection": "sqldocs__vnemb_1024__c1",
    "url": "http://localhost:6333",
    "dense_vector": "dense",
    "sparse_vector": "bm25",
    "payload_index_fields": [
      "doc_id",
      "table_name",
      "section"
    ]
  },
  "retrieval": {
    "mode": "hybrid",
    "candidate_k": 20,
    "rrf_k": 40,
    "rrf_weights": [
      0.5,
      0.5
    ],
    "rerank": {
      "model": "AITeamVN/Vietnamese_Reranker",
      "top_n": 5
    }
  }
}
