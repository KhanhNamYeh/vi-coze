{
  "kb": "sql",
  "name": "Tài liệu mô tả schema CSDL",
  "description": "Mỗi mục là một bảng: ý nghĩa, danh sách cột, mối liên kết, ghi chú nghiệp vụ. Cắt theo cấu trúc vì ranh giới bảng đã rõ sẵn.",

  "parse": {
    "loader": "docx_markitdown",
    "suffixes": [".docx", ".doc", ".pdf", ".pptx", ".xlsx", ".html", ".htm"],
    "clean": {
      "normalize_nfc": true,
      "strip_invisible": true,
      "strip_html": true,
      "block_injection": true
    }
  },

  "extract": {
    "enabled": false,
    "extractor": "schema_extract"
  },

  "link": {
    "enabled": false,
    "builder": "knowledge_graph",
    "llm": {
      "base_url": "http://localhost:11434/v1",
      "model": "llama3",
      "temperature": 0.1
    }
  },

  "chunk": {
    "mode": "structural",
    "headers": [["#", "section"], ["##", "table"]],
    "strip_headers": false,
    "overlap": 0,
    "max_chars": 6000,
    "min_chars": 200
  },

  "embed": {
    "dense": {
      "model": "AITeamVN/Vietnamese_Embedding",
      "dim": 1024,
      "batch": 16,
      "max_tokens": 2048,
      "normalize": true,
      "query_prefix": "",
      "passage_prefix": ""
    },
    "sparse": {
      "model": "Qdrant/bm25",
      "disable_stemmer": true,
      "k": 1.2,
      "b": 0.0
    }
  },

  "index": {
    "store": "qdrant",
    "collection": "sqldocs__vnemb_1024__c1",
    "url": "http://localhost:6333",
    "dense_vector": "dense",
    "sparse_vector": "bm25",
    "payload_index_fields": ["doc_id", "table_name", "section"]
  },

  "retrieval": {
    "mode": "hybrid",
    "candidate_k": 20,
    "rrf_k": 40,
    "rrf_weights": [0.5, 0.5],
    "rerank": {
      "model": "AITeamVN/Vietnamese_Reranker",
      "top_n": 5
    }
  }
}
