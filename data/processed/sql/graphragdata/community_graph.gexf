      <node id="branch_code" label="branch_code">
        <attvalues>
          <attvalue for="0" value="branch_code" />
          <attvalue for="1" value="Here is a summarized paragraph:&#10;&#10;The &quot;branch_code&quot; entity represents the branch code of a commune/ward that a user has access to. This branch code is categorized under the type of Trung Tâm Kinh Doanh (TTKD), specifically identifying the user's access to one of the following branches: Trung Tâm Kinh Doanh Sài Gòn, Gia Định, Bến Thành, Gò Vấp, Thủ Đức, Bình Dương, or Vũng Tàu. The branch code is comprised of the Mã TTKD and Mã TTKD/chi nhánh, providing a unique identifier for each branch." />
          <attvalue for="2" value="7" />
          <attvalue for="3" value="56" />
        </attvalues>
      </node>
