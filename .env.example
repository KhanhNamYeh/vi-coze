# Cấu hình LLM cho nhánh SQL. File này KHÔNG lên git (.gitignore).
# Mẫu không kèm khoá: .env.example
#
# Chạy thử toàn bộ model:  python -m src.branch_sql.online.llm

# ── Qdrant. Khớp với cổng trong docker-compose.yml. ──────────────────────────
QDRANT_URL=http://localhost:6333

# Tuỳ chọn — nơi cache model HuggingFace (~2,2 GB mỗi model).
# Bỏ trống thì dùng mặc định ~/.cache/huggingface
# HF_HOME=

# Tuỳ chọn — token HF, chỉ cần khi tải model private hoặc bị rate limit.
# HF_TOKEN=

# ── Google AI Studio (Gemini + Gemma) ────────────────────────────────────────
GOOGLE_API_KEY=
# Gemma phát hành trên AI Studio dưới tên đầy đủ; "Gemma 4 26B" = gemma-4-26b-a4b-it
GOOGLE_MODELS=gemini-3.5-flash-lite,gemma-4-26b-a4b-it

# ── OpenRouter (gateway, chọn bản :free) ─────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free

# ── NVIDIA NIM (integrate.api.nvidia.com) ────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# deepseek-ai/deepseek-v4-flash đã hết vòng đời trên NIM ngày 2026-08-07 (HTTP
# 410). Bản snapshot -0731 vẫn nằm trong /v1/models nhưng không có endpoint
# phục vụ: request treo tới hết timeout thay vì báo lỗi. Bỏ khỏi danh sách.
NVIDIA_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b

# ── OpenAI (trả phí, không có bậc free) ──────────────────────────────────────
# gpt-5.6-* chỉ gọi được function tool qua Responses API; registry tự bật
# use_responses_api=True cho provider này.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-5.6-terra,gpt-5.6-luna,gpt-5.4

# ── Model mặc định pipeline dùng (dạng "<provider>:<model>") ─────────────────
SQL_LLM=google:gemini-3.5-flash-lite
