# Copy sang .env rồi chỉnh. File .env nằm trong .gitignore.

# Qdrant. Khớp với cổng trong docker-compose.yml.
QDRANT_URL=http://localhost:6333

# Tuỳ chọn — nơi cache model HuggingFace (~2,2 GB mỗi model).
# Bỏ trống thì dùng mặc định ~/.cache/huggingface
# HF_HOME=

# Tuỳ chọn — token HF, chỉ cần khi tải model private hoặc bị rate limit.
# HF_TOKEN=
